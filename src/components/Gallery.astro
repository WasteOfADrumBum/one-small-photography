---
import type { GalleryPhoto } from '@/lib/albums';
import { photoSrcset, photoUrl } from '@/lib/photo-url';
import PhotoSettingsLine from '@/components/PhotoSettingsLine';

interface Props {
  photos: GalleryPhoto[];
}
const { photos } = Astro.props;
---

<div class="mt-14 columns-1 gap-4 sm:columns-2 lg:columns-3">
  {photos.map((photo, index) => (
    <button
      type="button"
      class="group mb-4 block w-full break-inside-avoid overflow-hidden rounded-sm bg-moss"
      data-gallery-item={index}
      data-src={photoUrl(photo, 'lg')}
      data-title={photo.title}
      data-description={photo.description}
      data-alt={photo.alt || photo.title}
      aria-label={`${photo.alt || photo.title || 'Photo'}. Open full screen.`}
      aria-haspopup="dialog"
      data-protected
    >
      <img
        src={photoUrl(photo, 'md')}
        srcset={photoSrcset(photo)}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        width={photo.width}
        height={photo.height}
        alt={photo.alt || photo.title}
        loading={index < 3 ? 'eager' : 'lazy'}
        decoding="async"
        draggable="false"
        data-protected
        class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </button>
  ))}
</div>

<!-- Each photo's settings line, rendered here once and copied into the viewer. -->
<div hidden>
  {photos.map((photo, index) => (
    <div data-settings-for={index}>
      <PhotoSettingsLine
        settings={{
          camera: photo.camera?.name,
          lens: photo.lens?.name,
          aperture: photo.aperture,
          shutterSpeed: photo.shutterSpeed,
          iso: photo.iso,
        }}
      />
    </div>
  ))}
</div>

<dialog
  data-lightbox
  class="m-0 h-dvh max-h-none w-dvw max-w-none bg-espresso/95 p-0 text-paper backdrop:bg-black/70"
  aria-label="Photo viewer"
>
  <div class="flex h-full flex-col">
    <div class="flex justify-end gap-2 p-4">
      <button
        data-prev
        class="rounded-full border border-sand/30 px-4 py-2 hover:border-gold"
        aria-label="Previous photo"
      >
        ←
      </button>
      <button
        data-next
        class="rounded-full border border-sand/30 px-4 py-2 hover:border-gold"
        aria-label="Next photo"
      >
        →
      </button>
      <button
        data-close
        class="rounded-full border border-sand/30 px-4 py-2 hover:border-gold"
        aria-label="Close"
      >
        ✕
      </button>
    </div>
    <figure class="flex min-h-0 flex-1 flex-col items-center justify-center gap-4 px-4 pb-6">
      <img
        data-image
        alt=""
        draggable="false"
        data-protected
        class="min-h-0 max-w-full flex-1 object-contain"
      />
      <figcaption class="max-w-2xl text-center">
        <p data-position class="sr-only" aria-live="polite"></p>
        <p data-title class="font-serif text-2xl"></p>
        <p data-description class="mt-1 text-sand"></p>
        <div data-settings class="mt-4"></div>
      </figcaption>
    </figure>
  </div>
</dialog>

<script>
  import { initLightbox } from '@/scripts/lightbox';
  initLightbox();
</script>
