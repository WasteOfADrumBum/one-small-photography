---
import { nav, site } from '@/lib/site';

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-sand/15 bg-espresso/85 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-2 px-4 py-3 sm:px-6"
    aria-label="Main"
  >
    <a href="/" class="block shrink-0 no-underline">
      <img
        src="/logo-480.webp"
        srcset="/logo-240.webp 240w, /logo-480.webp 480w, /logo-720.webp 720w"
        sizes="(min-width: 640px) 216px, 154px"
        width="1495"
        height="389"
        alt={site.name}
        decoding="async"
        class="h-10 w-auto sm:h-14"
      />
    </a>
    <ul class="flex flex-wrap gap-2 text-sm">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={current.startsWith(item.href) ? 'page' : undefined}
            class="btn-gilt btn-gilt-nav px-3 py-1.5 sm:px-4"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
