---
import { copyright } from '@/lib/copyright';
import { footerNav } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-sand/15">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-sand sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      &copy; {year} {copyright.holder}. All rights reserved.
    </p>
    <p class="flex flex-wrap gap-x-5 gap-y-2">
      <span>Made in the NC Triad, shot on Nikon.</span>
      {footerNav.map((item) => (
        <a href={item.href} class="text-sand/70 no-underline hover:text-gold">
          {item.label}
        </a>
      ))}
      <a href="/login" class="text-sand/70 no-underline hover:text-gold">
        Log in
      </a>
    </p>
  </div>
</footer>
