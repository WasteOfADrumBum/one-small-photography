---
import { copyright } from '@/lib/copyright';
import { footerNav } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-sand/15">
  <div class="mx-auto grid max-w-6xl gap-3 px-4 py-8 text-center text-sm text-sand sm:grid-cols-3 sm:items-center sm:px-6">
    <p class="sm:text-left">
      &copy; {year} {copyright.holder}. All rights reserved.
    </p>
    <p>
      {footerNav.map((item) => (
        <a href={item.href} class="text-sand/80 no-underline hover:text-gold">
          {item.label}
        </a>
      ))}
    </p>
    <p class="sm:text-right">Made in the NC Triad, shot on Nikon.</p>
  </div>
</footer>
