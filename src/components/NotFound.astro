---
/** The "page not found" message, shared by the 404 page and album pages that don't exist. */
---

<section class="mx-auto max-w-3xl px-4 py-32 text-center sm:px-6">
  <p class="font-hand text-4xl text-gold">Out of frame.</p>
  <h1 class="title-sunlit mt-4 text-4xl">
    <span>This page doesn't exist.</span>
  </h1>
  <a href="/" class="mt-8 inline-block">
    Back to the start
  </a>
</section>
