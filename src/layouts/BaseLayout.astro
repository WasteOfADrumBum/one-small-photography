---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/lib/site';
import { photoUrl } from '@/lib/photo-url';

interface Props {
  title?: string;
  description?: string;
  /** Keep private pages (login, setup) out of search results. */
  noindex?: boolean;
  /** The picture shown when the page is shared: a photo, or a path under public/. */
  image?: { id: string; format: string } | string | undefined;
}

const {
  title,
  description = `${site.owner}'s photography portfolio, made in the North Carolina Triad.`,
  noindex = false,
  image,
} = Astro.props;
/** The branded share card (public/og-card.jpg, 1200x630) unless a page passes its own picture. */
const isShareCard = image === undefined;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(
  image === undefined ? '/og-card.jpg' : typeof image === 'string' ? image : photoUrl(image, 'md'),
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#15120f" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={shareImage} />
    {isShareCard && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content={`${site.name}: Dusty the horse in a Polaroid frame beside the logo`}
        />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-moss focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotion } from '@/scripts/motion';
      import { initPhotoProtection } from '@/scripts/protect-photos';
      initMotion();
      initPhotoProtection();
    </script>
  </body>
</html>
