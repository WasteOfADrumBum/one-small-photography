---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';
---

<BaseLayout
  title="The Triad"
  description="Photographing Greensboro, High Point and Winston-Salem, North Carolina."
>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h1 class="text-5xl" data-reveal>
      The Triad
    </h1>
    <p class="mt-4 max-w-xl text-sand" data-reveal>
      Home base is {site.homeBase}, right in the middle of North Carolina's Piedmont Triad. These
      are the roads that lead me to the light, and to the art waiting at the end of them.
    </p>
    <ul class="mt-16 grid gap-6 sm:grid-cols-3">
      {site.triadCities.map((city) => (
        <li class="rounded-lg border border-sand/20 bg-moss p-8" data-reveal>
          <span class="font-serif text-3xl text-gold">{city}</span>
        </li>
      ))}
    </ul>
    <figure
      class="mt-10 overflow-hidden rounded-lg border border-sand/20 bg-moss p-4 sm:p-8"
      data-reveal
    >
      <picture>
        <source srcset="/triad-streets.webp" type="image/webp" />
        <img
          src="/triad-streets.png"
          width="2000"
          height="2000"
          loading="lazy"
          decoding="async"
          alt="Street map of the Piedmont Triad, with roads linking Winston-Salem, Greensboro and High Point."
          class="mx-auto h-auto w-full max-w-3xl opacity-90 [mask-image:radial-gradient(closest-side,black_70%,transparent)]"
        />
      </picture>
    </figure>
  </section>
</BaseLayout>
