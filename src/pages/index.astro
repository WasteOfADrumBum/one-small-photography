---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PolaroidStack from '@/components/PolaroidStack.astro';
import { site } from '@/lib/site';
import { listPublishedAlbums, stackPhotos, type PublicAlbum } from '@/lib/albums';
import { FEATURED_ALBUM_COUNT } from '@/lib/featured';
import { hasDatabase } from '@/db/client';

// Rendered on each visit so the featured albums always match the admin panel.
export const prerender = false;

let featured: PublicAlbum[] = [];
if (hasDatabase()) {
  try {
    featured = await listPublishedAlbums(FEATURED_ALBUM_COUNT);
  } catch (err) {
    console.error('Could not load featured albums', err);
  }
}
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const tones = ['moss', 'gold', 'sage'] as const;
const years = new Date().getFullYear() - site.shootingSince;
---

<BaseLayout>
  <section class="mx-auto flex min-h-[80dvh] max-w-6xl flex-col justify-center px-4 py-24 sm:px-6">
    <p class="mb-6 text-sm tracking-[0.3em] text-sage uppercase" data-reveal>
      {site.owner} · North Carolina
    </p>
    <h1 class="max-w-4xl text-5xl leading-[1.05] sm:text-7xl" data-reveal>
      {site.tagline}
    </h1>
    <p class="mt-8 max-w-xl text-lg text-sand" data-reveal>
      {years}+ years behind a Nikon, in the studio and on location: fashion, portraits, families,
      weddings, sports, landscapes and animals.
    </p>
    <div class="mt-10 flex flex-wrap gap-4" data-reveal>
      <a
        href="/portfolio"
        class="rounded-full bg-sage px-6 py-3 text-espresso no-underline transition-colors hover:bg-gold"
      >
        See the portfolio
      </a>
      <a
        href="/contact"
        class="rounded-full border border-sand/40 px-6 py-3 text-paper no-underline transition-colors hover:border-gold"
      >
        Say hello
      </a>
    </div>
  </section>

  <section class="bg-moss/60">
    <div class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-24 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-12 sm:px-6">
      <div data-reveal>
        <h2 class="text-4xl leading-tight">
          Why <strong class="font-semibold text-gold">One Small</strong> Photo
        </h2>
        <figure class="mt-10 max-w-sm -rotate-2 rounded-sm bg-polaroid p-3 pb-2 shadow-2xl shadow-black/50">
          <picture>
            <source
              type="image/webp"
              srcset="/dusty-800.webp 800w, /dusty-1200.webp 1200w"
              sizes="(min-width: 640px) 24rem, 100vw"
            />
            <img
              src="/dusty-1600.jpg"
              width="1600"
              height="1062"
              loading="lazy"
              decoding="async"
              alt="Dusty, a chestnut horse with a white blaze and blond mane, grazing beside a metal gate in autumn."
              class="h-auto w-full"
            />
          </picture>
          <figcaption class="pt-2 text-center font-hand text-xl text-espresso">
            Dusty, Virginia, 2014
          </figcaption>
        </figure>
      </div>
      <div class="space-y-5 text-lg text-sand" data-reveal>
        <p>
          Small is the family name. One Small Family, One Small Studio, One Small Photo: everything
          made here carries it.
        </p>
        <p>
          In 2014, a portrait of Dusty, a horse from Virginia, was published in Photographer's Forum
          Magazine. Photography has been part of life ever since, and this is where the work lives.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="mb-16 text-center text-4xl" data-reveal>
      Albums
    </h2>
    <div class="grid gap-20 sm:grid-cols-3" data-reveal>
      {featured.length > 0
        ? featured.map((album, i) => (
            <a href={`/portfolio/${album.slug}`} class="no-underline">
              <PolaroidStack
                title={album.title}
                tone={tones[i % tones.length]}
                photos={stackPhotos(album).slice(0, 3)}
              />
            </a>
          ))
        : ['Portraits', 'Fashion', 'Weddings'].map((title, i) => (
            <PolaroidStack title={title} tone={tones[i % tones.length]} />
          ))}
    </div>
    <p class="mt-16 text-center" data-reveal>
      <a href="/portfolio">See every album →</a>
    </p>
  </section>
</BaseLayout>
