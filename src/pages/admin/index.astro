---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AlbumsManager from '@/components/admin/AlbumsManager';
import GearManager from '@/components/admin/GearManager';
import MessagesInbox from '@/components/admin/MessagesInbox';
import { listAlbums } from '@/lib/albums';
import { listGear } from '@/lib/gear';
import { listMessages } from '@/lib/messages';

export const prerender = false;

// Plain JSON so dates cross into the React island as strings.
const albums = JSON.parse(JSON.stringify(await listAlbums()));
const [cameras, lenses] = await Promise.all([listGear('cameras'), listGear('lenses')]);
const messages = JSON.parse(JSON.stringify(await listMessages()));
const pick = (list: { id: string; name: string }[]) => list.map(({ id, name }) => ({ id, name }));
---

<AdminLayout title="Your albums">
  <MessagesInbox client:load initialMessages={messages} />
  <AlbumsManager client:load initialAlbums={albums} />
  <GearManager client:load initialCameras={pick(cameras)} initialLenses={pick(lenses)} />
</AdminLayout>
