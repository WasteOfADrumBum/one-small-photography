---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminTabs from '@/components/admin/AdminTabs';
import { listAlbums } from '@/lib/albums';
import { listGear } from '@/lib/gear';
import { listMessages } from '@/lib/messages';

export const prerender = false;

// Plain JSON so dates cross into the React island as strings.
const albums = JSON.parse(JSON.stringify(await listAlbums()));
const [cameras, lenses] = await Promise.all([listGear('cameras'), listGear('lenses')]);
const messages = JSON.parse(JSON.stringify(await listMessages()));
const pick = (list: { id: string; name: string }[]) => list.map(({ id, name }) => ({ id, name }));
---

<AdminLayout title="Admin">
  <AdminTabs
    client:load
    albums={albums}
    gear={{ initialCameras: pick(cameras), initialLenses: pick(lenses) }}
    messages={messages}
  />
</AdminLayout>
