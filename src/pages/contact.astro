---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm';
---

<BaseLayout title="Contact" description="Say hello to Joshua Small.">
  <figure class="mx-auto max-w-6xl px-4 pt-12 sm:px-6" data-reveal>
    <img
      src="/contact-portraits-1100.webp"
      srcset="/contact-portraits-1100.webp 1100w, /contact-portraits-2172.webp 2172w"
      sizes="(min-width: 72rem) 70rem, 100vw"
      width="2172"
      height="724"
      decoding="async"
      alt="Five studio portraits of women side by side, framed by painted leaves and small yellow and white flowers."
      class="h-auto w-full"
    />
  </figure>
  <section class="mx-auto max-w-3xl px-4 pt-10 pb-20 sm:px-6">
    <h1 class="text-5xl" data-reveal>
      Say hello
    </h1>
    <div class="mt-6 space-y-4 text-lg text-sand" data-reveal>
      <p>
        I'm not booking shoots these days, so this isn't a hire-me page. It's here for everything
        else.
      </p>
      <p>
        Maybe a photo stuck with you, or you shoot in the Triad and want to compare notes. Maybe you
        want to talk gear, editing, music or code. I'm always glad to meet people who make things.
      </p>
    </div>
    <div class="mt-10" data-reveal>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
