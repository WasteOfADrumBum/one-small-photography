---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import { getPublishedAlbumBySlug } from '@/lib/albums';
import { hasDatabase } from '@/db/client';

export const prerender = false;

const album =
  hasDatabase() && Astro.params.slug ? await getPublishedAlbumBySlug(Astro.params.slug) : undefined;
if (!album) return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
---

<BaseLayout
  title={album.title}
  description={album.description || `${album.title}: a photo album by Joshua Small.`}
>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <a href="/portfolio" class="text-sm">
      ← All albums
    </a>
    <h1 class="mt-6 text-5xl" data-reveal>
      {album.title}
    </h1>
    {album.description && (
      <p class="mt-4 max-w-2xl text-lg text-sand" data-reveal>
        {album.description}
      </p>
    )}
    <Gallery photos={album.photos} />
  </section>
</BaseLayout>
