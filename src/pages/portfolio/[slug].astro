---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import NotFound from '@/components/NotFound.astro';
import { getPublishedAlbumBySlug } from '@/lib/albums';
import { hasDatabase } from '@/db/client';
import { copyright } from '@/lib/copyright';
import { photoUrl } from '@/lib/photo-url';
import { site } from '@/lib/site';
import { albumPhotoAlt, photoAlt } from '@/lib/alt-text';

export const prerender = false;

const album =
  hasDatabase() && Astro.params.slug ? await getPublishedAlbumBySlug(Astro.params.slug) : undefined;

// Never cache album pages on the CDN or in the browser, so edits from the admin
// panel show up on the next page load. Photos themselves are still cached by /img.
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');
// A missing or hidden album answers 404 with the not-found message. (Astro can't
// rewrite an on-demand page to the prerendered /404, so it's rendered here.)
if (!album) Astro.response.status = 404;

// Copyright and credit for search engines (Google shows it beside image results).
const absolute = (path: string) => new URL(path, Astro.site).href;
const rights = {
  creator: { '@type': 'Person', name: site.owner },
  copyrightHolder: { '@type': 'Organization', name: copyright.holder, url: copyright.website },
  copyrightNotice: copyright.notice,
  creditText: copyright.holder,
  acquireLicensePage: absolute('/contact'),
};
const structuredData = album && {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: album.title,
  url: absolute(`/portfolio/${album.slug}`),
  ...rights,
  image: album.photos.map((photo, i) => ({
    '@type': 'ImageObject',
    contentUrl: absolute(photoUrl(photo, 'lg')),
    name: photo.title || undefined,
    caption: photoAlt(photo, albumPhotoAlt(album.title, i + 1)),
    ...rights,
  })),
};
---

{!album ? (
  <BaseLayout title="Not found" noindex>
    <NotFound />
  </BaseLayout>
) : (
  <BaseLayout
    title={album.title}
    description={album.description || `${album.title}: a photo album by ${site.owner}.`}
    image={album.photos.find((p) => p.id === album.coverPhotoId) ?? album.photos[0]}
  >
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <a href="/portfolio" class="text-sm">
        ← All albums
      </a>
      <h1 class="mt-6 text-5xl" data-reveal>
        {album.title}
      </h1>
      {album.description && (
        <p class="mt-4 max-w-2xl text-lg text-sand" data-reveal>
          {album.description}
        </p>
      )}
      <Gallery photos={album.photos} albumTitle={album.title} />
    </section>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  </BaseLayout>
)}
