---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PolaroidStack from '@/components/PolaroidStack.astro';
import { listPublishedAlbums, stackPhotos, type PublicAlbum } from '@/lib/albums';
import { hasDatabase } from '@/db/client';

export const prerender = false;

let albums: PublicAlbum[] = [];
if (hasDatabase()) {
  try {
    albums = await listPublishedAlbums();
  } catch (err) {
    console.error('Could not load albums', err);
  }
}
// Never cache album pages on the CDN or in the browser, so edits from the admin
// panel show up on the next page load. Photos themselves are still cached by /img.
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const tones = ['moss', 'gold', 'sage'] as const;
// One, two or three per row, matching the gap below. A flex row (not a grid) so a
// partly filled last row sits in the middle instead of hugging the left edge.
const cell = 'w-full sm:w-[calc((100%-2.5rem)/2)] lg:w-[calc((100%-5rem)/3)]';
const placeholders = ['Portraits', 'Fashion & Models', 'Landscapes & Nature', 'Events', 'Weddings'];
---

<BaseLayout
  title="Portfolio"
  description="Albums of portrait, fashion, landscape, event and wedding photography."
>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h1 class="title-sunlit text-5xl" data-reveal>
      Portfolio
    </h1>
    <p class="mt-4 max-w-xl text-sand" data-reveal>
      Each album is a stack of prints. Pick one to open the full gallery.
    </p>
    <div class="mt-20 flex flex-wrap justify-center gap-x-10 gap-y-28">
      {albums.length > 0
        ? albums.map((album, i) => (
            <a href={`/portfolio/${album.slug}`} class:list={[cell, 'no-underline']} data-reveal>
              <PolaroidStack
                title={album.title}
                tone={tones[i % tones.length]}
                photos={stackPhotos(album).slice(0, 3)}
                subtitle={`${album.photos.length} ${album.photos.length === 1 ? 'photo' : 'photos'}`}
              />
            </a>
          ))
        : placeholders.map((title, i) => (
            <div class={cell} data-reveal>
              <PolaroidStack
                title={title}
                tone={tones[i % tones.length]}
                subtitle="Photos coming soon"
              />
            </div>
          ))}
    </div>
  </section>
</BaseLayout>
