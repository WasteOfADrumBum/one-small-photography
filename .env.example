# Copy to .env for local development. Real values live in Vercel's
# project settings, never in the repo.

# Neon Postgres (added from Vercel's Storage tab)
DATABASE_URL=

# Backblaze B2 (application key limited to the photo bucket)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=

# One-time account setup: any long random phrase. Visit /setup to create your
# login with it; the page turns itself off once your account exists.
SETUP_TOKEN=
# Local development only: store photos in this folder instead of B2.
# STORAGE_DIR=.photos
