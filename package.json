{
  "name": "one-small-photography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OneSmallPhoto: photography portfolio for Joshua Small, serving the NC Triad.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "vercel-build": "node scripts/migrate.mjs && astro build",
    "db:generate": "drizzle-kit generate",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:migrations": "vitest run src/test/migrations.test.ts",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "audit:policy": "node scripts/ci/audit-policy.mjs",
    "secrets:scan": "bash scripts/ci/secret-scan.sh",
    "workflows:lint": "bash scripts/ci/workflow-lint.sh",
    "verify": "npm run format:check && npm run lint && npm run check && npm test"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/vercel": "^11.0.11",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "drizzle-orm": "^0.45.3",
    "exifr": "^7.1.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "11.1.9",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-eslint-parser": "^1.4.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    },
    "zod": "$zod"
  }
}
